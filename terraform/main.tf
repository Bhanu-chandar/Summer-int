locals {
  # Explicit private key wins; otherwise assume "<public_key_path> minus .pub".
  private_key_path = var.private_key_path != "" ? pathexpand(var.private_key_path) : replace(pathexpand(var.public_key_path), ".pub", "")
}

# ---------------------------------------------------------------------------
# Look-ups
# ---------------------------------------------------------------------------

data "aws_availability_zones" "available" {
  state = "available"
}

# Latest Amazon Linux 2023 x86_64 AMI, resolved at plan time.
data "aws_ami" "al2023" {
  most_recent = true
  owners      = ["amazon"]

  filter {
    name   = "name"
    values = ["al2023-ami-2023.*-x86_64"]
  }

  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }
}

# ---------------------------------------------------------------------------
# Network: VPC + public subnet + internet gateway + route table
# ---------------------------------------------------------------------------

resource "aws_vpc" "main" {
  cidr_block           = var.vpc_cidr
  enable_dns_support   = true
  enable_dns_hostnames = true

  tags = { Name = "${var.project_name}-vpc" }
}

resource "aws_internet_gateway" "main" {
  vpc_id = aws_vpc.main.id

  tags = { Name = "${var.project_name}-igw" }
}

resource "aws_subnet" "public" {
  vpc_id                  = aws_vpc.main.id
  cidr_block              = var.subnet_cidr
  availability_zone       = data.aws_availability_zones.available.names[0]
  map_public_ip_on_launch = true

  tags = { Name = "${var.project_name}-public" }
}

resource "aws_route_table" "public" {
  vpc_id = aws_vpc.main.id

  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.main.id
  }

  tags = { Name = "${var.project_name}-public-rt" }
}

resource "aws_route_table_association" "public" {
  subnet_id      = aws_subnet.public.id
  route_table_id = aws_route_table.public.id
}

# ---------------------------------------------------------------------------
# Security group: inbound 80 (HTTP) and 22 (SSH), all egress
# ---------------------------------------------------------------------------

resource "aws_security_group" "web" {
  name        = "${var.project_name}-web-sg"
  description = "Allow HTTP (80) and SSH (22) inbound"
  vpc_id      = aws_vpc.main.id

  tags = { Name = "${var.project_name}-web-sg" }
}

resource "aws_vpc_security_group_ingress_rule" "http" {
  security_group_id = aws_security_group.web.id
  description       = "HTTP from the internet"
  cidr_ipv4         = var.http_allowed_cidr
  from_port         = 80
  to_port           = 80
  ip_protocol       = "tcp"
}

resource "aws_vpc_security_group_ingress_rule" "ssh" {
  security_group_id = aws_security_group.web.id
  description       = "SSH for Ansible / admin"
  cidr_ipv4         = var.ssh_allowed_cidr
  from_port         = 22
  to_port           = 22
  ip_protocol       = "tcp"
}

resource "aws_vpc_security_group_egress_rule" "all" {
  security_group_id = aws_security_group.web.id
  description       = "All outbound (image pulls, package updates)"
  cidr_ipv4         = "0.0.0.0/0"
  ip_protocol       = "-1"
}

# ---------------------------------------------------------------------------
# Key pair + instance
# ---------------------------------------------------------------------------

resource "aws_key_pair" "deployer" {
  key_name   = "${var.project_name}-key"
  public_key = file(pathexpand(var.public_key_path))
}

resource "aws_instance" "web" {
  ami                    = data.aws_ami.al2023.id
  instance_type          = var.instance_type
  subnet_id              = aws_subnet.public.id
  vpc_security_group_ids = [aws_security_group.web.id]
  key_name               = aws_key_pair.deployer.key_name

  # Docker is installed here, at first boot, before Ansible ever connects.
  user_data = templatefile("${path.module}/user_data.sh", {
    ssh_user = var.ansible_ssh_user
  })

  # Replace the instance if the bootstrap script changes.
  user_data_replace_on_change = true

  root_block_device {
    volume_size           = var.root_volume_size
    volume_type           = "gp3"
    encrypted             = true
    delete_on_termination = true
  }

  metadata_options {
    http_tokens   = "required" # IMDSv2 only
    http_endpoint = "enabled"
  }

  tags = { Name = "${var.project_name}-web" }
}

# Stable address that survives stop/start, so the Ansible inventory stays valid.
resource "aws_eip" "web" {
  instance = aws_instance.web.id
  domain   = "vpc"

  tags = { Name = "${var.project_name}-eip" }
}

# ---------------------------------------------------------------------------
# Hand-off to Ansible (Task 1): generate the inventory automatically
# ---------------------------------------------------------------------------

resource "local_file" "ansible_inventory" {
  filename        = "${path.module}/../ansible/inventory/hosts.ini"
  file_permission = "0644"

  content = <<-EOT
    # Generated by Terraform - do not edit by hand.
    # Regenerate with: terraform apply
    [web]
    ${var.project_name}-web ansible_host=${aws_eip.web.public_ip}

    [web:vars]
    ansible_user=${var.ansible_ssh_user}
    ansible_ssh_private_key_file=${local.private_key_path}
    ansible_ssh_common_args='-o StrictHostKeyChecking=accept-new'
  EOT
}

# Optional extra app ports (Task 4 supports exposing on 80 or 8080).
resource "aws_vpc_security_group_ingress_rule" "extra" {
  for_each = toset([for p in var.extra_ingress_ports : tostring(p)])

  security_group_id = aws_security_group.web.id
  description       = "Extra app port ${each.value}"
  cidr_ipv4         = var.http_allowed_cidr
  from_port         = tonumber(each.value)
  to_port           = tonumber(each.value)
  ip_protocol       = "tcp"
}

# Optional Jenkins controller port (Tasks 5 & 6).
resource "aws_vpc_security_group_ingress_rule" "jenkins" {
  count = var.jenkins_ingress_enabled ? 1 : 0

  security_group_id = aws_security_group.web.id
  description       = "Jenkins UI + GitHub webhook"
  cidr_ipv4         = var.jenkins_allowed_cidr
  from_port         = 8080
  to_port           = 8080
  ip_protocol       = "tcp"

  lifecycle {
    precondition {
      condition     = !contains(var.extra_ingress_ports, 8080)
      error_message = "Port 8080 is requested twice: remove 8080 from extra_ingress_ports, or set jenkins_ingress_enabled = false. AWS rejects duplicate security group rules."
    }
  }
}
