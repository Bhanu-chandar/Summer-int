# {{ ansible_managed }}
# Rendered by the "app" Ansible role - edit roles/app/templates/, not this file.
name: {{ app_name }}

services:
  web:
    image: {{ app_image }}
    container_name: {{ app_name }}-web
    restart: unless-stopped
    pull_policy: always
    ports:
      - "{{ app_http_port }}:80"
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1/healthz"]
      interval: 30s
      timeout: 3s
      retries: 3
      start_period: 5s
    labels:
      com.centurylinklabs.watchtower.enable: "true"
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks: [web]
{% if watchtower_enabled %}

  watchtower:
    image: containrrr/watchtower:1.7.1
    container_name: {{ app_name }}-watchtower
    restart: unless-stopped
    command: --label-enable --cleanup --rolling-restart --include-restarting
    environment:
      WATCHTOWER_POLL_INTERVAL: "{{ watchtower_poll_interval }}"
      WATCHTOWER_TIMEOUT: 30s
      TZ: "{{ app_timezone }}"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
    networks: [web]
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
{% endif %}

networks:
  web:
    driver: bridge
