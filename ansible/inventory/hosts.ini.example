# Terraform writes the real inventory/hosts.ini for you (terraform apply).
# Use this template only if you provisioned the server some other way.
[web]
summerint-web ansible_host=203.0.113.10

[web:vars]
ansible_user=ec2-user
ansible_ssh_private_key_file=~/.ssh/id_rsa
ansible_ssh_common_args='-o StrictHostKeyChecking=accept-new'
