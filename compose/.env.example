# Copy to .env next to the compose files:  cp .env.example .env

# --- image ---------------------------------------------------------------
IMAGE_NAME=docker.io/instantprachi/summerint-site
IMAGE_TAG=latest

# --- host port -----------------------------------------------------------
# dev  : 8080 (avoids needing root to bind 80)
# prod : 80
HTTP_PORT=8080

# --- watchtower (prod overlay only) --------------------------------------
WATCHTOWER_POLL_INTERVAL=300
TZ=Asia/Kolkata
